# Normalise text in the repo, native in the working tree. Set at the
# initial commit on purpose — doing it later rewrites every file.
* text=auto

# Must stay LF or they will not run
*.sh    text eol=lf
*.ino   text
*.mstr  text
*.json  text
*.js    text
*.css   text
*.md    text

# Binaries: never diff, never line-ending-mangle
*.obj   binary
*.step  binary
*.stl   binary
*.zip   binary
*.tgz   binary
*.mp4   binary
*.r2m   binary
*.png   binary
*.jpg   binary
*.wav   binary
*.mp3   binary

# ---------------------------------------------------------------------
# Nothing in this repository is anywhere near GitHub's 100 MB file limit,
# and nothing needs Git LFS. The biggest tracked file is the rigged MK4
# geometry at 2.6 MB; the raw 250 MB Fusion exports it was made from have
# never been in here and are excluded by .gitignore. Keep it that way.
# ---------------------------------------------------------------------

# Generated by the build and tracked on purpose (see .gitignore). A build
# output must never be line-ending-converted: the build always writes LF, so
# any conversion leaves it permanently "modified" after every rebuild.
pca-studio/PCA-Studio.html -text
