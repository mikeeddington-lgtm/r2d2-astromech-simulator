  <Script ScriptDone="true"># DIAGNOSTIC. All eight slots do the same thing: flap the four pies
# twice. If ANY combo moves them, the Mega is reaching the board.
quit

# PING 0 RT-Up
sub PING_0_RTUp
  700 7296 7296 7744 7296 frame_0..3 # open
  700 4544 4544 5056 4544 frame_0..3 # shut
  700 7296 7296 7744 7296 frame_0..3 # open
  700 4544 4544 5056 4544 frame_0..3 # shut
  return
