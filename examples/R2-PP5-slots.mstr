  <Script ScriptDone="true"># PP5 ONLY. Channel 0. Nothing else on the board is touched.
#
# All eight subroutines do the same thing, so ANY Padawan combo
# (R2 or L2 + any d-pad direction) flaps PP5 open and shut twice.
# Movement of any kind means restartScript() is reaching the board.
#
# DO NOT press "Copy all Sequences to Script" — this script is
# hand-written and that button would overwrite it.
quit

# restartScript(0)
sub PP5_slot_0
  7296 0 servo   1500 delay
  4544 0 servo   1500 delay
  7296 0 servo   1500 delay
  4544 0 servo   1500 delay
  return
