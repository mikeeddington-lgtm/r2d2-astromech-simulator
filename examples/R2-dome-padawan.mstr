  <Script ScriptDone="true"># No main program: every sequence below is a subroutine, called by
# restartScript(0..7) from the Mega. The bare quit stops Run Script
# falling through into the first sequence and returning with an empty
# call stack, which is error 0x0080.
quit

# Dome Pies Open
sub Dome_Pies_Open
  400 7744 frame_2 # PP1 open
  400 7296 frame_3 # PP2 open
  400 7296 frame_0 # PP5 open
  400 7296 frame_1 # PP6 open
  return
# Dome Pies Close
sub Dome_Pies_Close
  400 4544 frame_1 # PP6 shut
  400 4544 frame_0 # PP5 shut
  400 4544 frame_3 # PP2 shut
  400 5056 frame_2 # PP1 shut
  return
# Dome Panels Open
sub Dome_Panels_Open
  380 8000 frame_9 # P1-Fix open
  380 7616 frame_10 # P2 open
  380 7360 frame_11 # P3 open
  380 7616 frame_12 # P4 open
  380 8000 frame_13 # P7 open
  380 7744 frame_16 # P11 open
  380 7616 frame_6 # P13 open
  return
# Dome Panels Close
sub Dome_Panels_Close
  380 4032 frame_6 # P13 shut
  380 4416 frame_16 # P11 shut
  380 4416 frame_13 # P7 shut
  380 3968 frame_12 # P4 shut
  380 4032 frame_11 # P3 shut
  380 4032 frame_10 # P2 shut
  380 3968 frame_9 # P1-Fix shut
  return
# Whole Dome Open
sub Whole_Dome_Open
  500 7296 7296 7744 7296 frame_0..3 # Pies
  1200 7616 8000 7616 7360 7616 
  8000 7744 frame_6_9..13_16 # Panels
  return
# Whole Dome Close
sub Whole_Dome_Close
  500 4032 3968 4032 4032 3968 
  4416 4416 frame_6_9..13_16 # Panels
  1200 4544 4544 5056 4544 frame_0..3 # Pies
  return
# Dome Wave
sub Dome_Wave
  400 7744 frame_2 # step 0
  400 7296 frame_3 # step 1
  400 7296 frame_0 # step 2
  400 7296 5056 frame_1_2 # step 3
  400 4544 8000 frame_3_9 # step 4
  400 4544 7616 frame_0_10 # step 5
  400 4544 7360 frame_1_11 # step 6
  400 3968 7616 frame_9_12 # step 7
  400 4032 8000 frame_10_13 # step 8
  400 4032 7744 frame_11_16 # step 9
  400 7616 3968 frame_6_12 # step 10
  400 4416 frame_13 # step 11
  400 4416 frame_16 # step 12
  400 4032 frame_6 # step 13
  return
# Dome Home
sub Dome_Home
  1200 4544 4544 5056 4544 5984 
  5984 4032 5984 5984 3968 4032 
  4032 3968 4416 5888 5984 4416 
  frame_0..16 # Home
  return

sub frame_2
  2 servo
  delay
  return

sub frame_3
  3 servo
  delay
  return

sub frame_0
  0 servo
  delay
  return

sub frame_1
  1 servo
  delay
  return

sub frame_9
  9 servo
  delay
  return

sub frame_10
  10 servo
  delay
  return

